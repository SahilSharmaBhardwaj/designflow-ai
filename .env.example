# ==============================================================================
# DesignFlow AI - Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# AI Provider Selection
# Options: "mock" (default, runs locally with zero API keys required), "anthropic", "openai"
AI_PROVIDER=mock

# Anthropic Claude API Configuration (Optional - only required if AI_PROVIDER=anthropic)
# Get your API key from https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# Anthropic Model Selection (Optional, defaults to claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Configuration (Optional - only required if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Application Configuration
NEXT_PUBLIC_APP_NAME="DesignFlow AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
